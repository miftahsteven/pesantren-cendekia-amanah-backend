generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================================
// ENUMS
// ==================================================

enum AdminStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PpdbStatus {
  SUBMITTED
  VERIFIED
  CONTACTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum AttendanceMode {
  BOARDING
  FULLDAY
  NON_FORMAL
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum NewsletterStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum BrochureStatus {
  AVAILABLE
  COMING_SOON
  ARCHIVED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  TIKTOK
  X
  OTHER
}

enum SlideTargetType {
  INTERNAL
  EXTERNAL
  NONE
}

enum StorageProvider {
  LOCAL
  S3
  MINIO
  CLOUDFLARE_R2
}

// ==================================================
// 1. AUTH & SECURITY MODELS
// ==================================================

model AdminUser {
  id               String        @id @default(uuid()) @db.Uuid
  name             String        @db.VarChar(150)
  email            String        @unique @db.VarChar(255)
  username         String?       @unique @db.VarChar(100)
  passwordHash     String        @map("password_hash") @db.Text
  status           AdminStatus   @default(ACTIVE)
  failedLoginCount Int           @default(0) @map("failed_login_count")
  lockedUntil      DateTime?     @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?     @map("last_login_at") @db.Timestamptz(3)
  lastLoginIp      String?       @map("last_login_ip") @db.VarChar(64)

  userRoles        AdminUserRole[]
  sessions         AdminSession[]
  auditLogs        AuditLog[]
  newsArticles     NewsArticle[]
  uploadedMedia    MediaAsset[]

  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(3)

  @@map("admin_users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(50)
  name            String           @db.VarChar(100)
  description     String?          @db.Text

  userRoles       AdminUserRole[]
  rolePermissions RolePermission[]

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(100)
  name            String           @db.VarChar(150)
  description     String?          @db.Text

  rolePermissions RolePermission[]

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("permissions")
}

model AdminUserRole {
  adminUserId String    @map("admin_user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid

  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(255)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  userAgent   String?   @map("user_agent") @db.Text
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)

  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tokenHash])
  @@index([adminUserId, expiresAt])
  @@map("admin_sessions")
}

model AuditLog {
  id           String     @id @default(uuid()) @db.Uuid
  actorAdminId String?    @map("actor_admin_id") @db.Uuid
  action       String     @db.VarChar(100)
  entityType   String     @map("entity_type") @db.VarChar(100)
  entityId     String?    @map("entity_id") @db.VarChar(100)
  ipAddress    String?    @map("ip_address") @db.VarChar(64)
  userAgent    String?    @map("user_agent") @db.Text
  metadata     Json?      @db.JsonB

  actor        AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorAdminId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================================================
// 2. MEDIA ASSET MODEL
// ==================================================

model MediaAsset {
  id               String          @id @default(uuid()) @db.Uuid
  storageProvider  StorageProvider @default(LOCAL) @map("storage_provider")
  storageKey       String          @unique @map("storage_key") @db.VarChar(500)
  publicUrl        String          @map("public_url") @db.VarChar(1000)

  originalFilename String          @map("original_filename") @db.VarChar(255)
  mimeType         String          @map("mime_type") @db.VarChar(100)
  fileExtension    String          @map("file_extension") @db.VarChar(20)
  sizeBytes        BigInt          @map("size_bytes")

  width            Int?
  height           Int?
  altText          String?         @map("alt_text") @db.VarChar(255)
  caption          String?         @db.Text
  checksumSha256   String?         @map("checksum_sha256") @db.VarChar(64)

  uploadedById     String?         @map("uploaded_by") @db.Uuid
  uploadedBy       AdminUser?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  galleryItems     GalleryItem[]

  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(3)

  @@index([storageKey])
  @@index([mimeType])
  @@index([createdAt])
  @@map("media_assets")
}

// ==================================================
// 3. SITE SETTINGS & NAVIGATION
// ==================================================

model SiteSetting {
  id              String   @id @default(uuid()) @db.Uuid
  siteName        String   @default("Pesantren Cendekia Amanah") @map("site_name") @db.VarChar(200)
  siteTagline     String   @default("LEMBAGA PENDIDIKAN TERPADU") @map("site_tagline") @db.VarChar(200)
  subTagline      String   @default("Mencetak Generasi Qurani, Berprestasi, Berjiwa Pemimpin") @map("sub_tagline") @db.VarChar(255)
  siteDescription String   @map("site_description") @db.Text

  foundingYear    Int      @default(2017) @map("founding_year")
  motto           String   @map("motto") @db.VarChar(255)

  leaderName      String   @default("KH. Cholil Nafis, Lc., MA., Ph.D") @map("leader_name") @db.VarChar(150)
  leaderRole      String   @default("Pengasuh Pesantren Cendekia Amanah") @map("leader_role") @db.VarChar(150)
  leaderTitle     String   @default("Ketua MUI Bidang Dakwah & Ukhuwah / Dosen Pascasarjana UI") @map("leader_title") @db.VarChar(255)
  leaderPhotoUrl  String   @default("/images/guru/leader.png") @map("leader_photo_url") @db.VarChar(500)
  leaderQuotes    String[] @default([]) @map("leader_quotes")

  phone           String   @map("phone") @db.VarChar(50)
  whatsapp        String   @map("whatsapp") @db.VarChar(50)
  email           String   @map("email") @db.VarChar(100)

  addressText     String   @map("address_text") @db.Text
  city            String   @default("Depok") @db.VarChar(100)
  province        String   @default("Jawa Barat") @db.VarChar(100)
  postalCode      String   @default("16413") @map("postal_code") @db.VarChar(20)
  mapsLink        String   @map("maps_link") @db.VarChar(500)
  mapsEmbedUrl    String   @map("maps_embed_url") @db.Text

  serviceHours    String   @default("Senin – Sabtu, 07.30 – 15.30 WIB") @map("service_hours") @db.VarChar(100)

  websiteUrl      String   @default("https://cendekiaamanah.sch.id") @map("website_url") @db.VarChar(255)
  consultationUrl String   @default("https://cholilnafis.id/#konsultasi") @map("consultation_url") @db.VarChar(255)
  virtualTourUrl  String   @default("https://www.youtube.com/watch?v=dQw4w9WgXcQ") @map("virtual_tour_url") @db.VarChar(255)

  seoTitle        String?  @map("seo_title") @db.VarChar(255)
  seoDescription  String?  @map("seo_description") @db.VarChar(500)

  logoUrl         String   @default("/logo/main-logo.png") @map("logo_url") @db.VarChar(500)
  faviconUrl      String   @default("/favicon.ico") @map("favicon_url") @db.VarChar(500)

  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_settings")
}

model SocialLink {
  id        String         @id @default(uuid()) @db.Uuid
  platform  SocialPlatform
  name      String         @db.VarChar(50)
  url       String         @db.VarChar(500)
  handle    String?        @db.VarChar(100)
  sortOrder Int            @default(0) @map("sort_order")
  isActive  Boolean        @default(true) @map("is_active")

  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("social_links")
}

model Menu {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(50)
  name      String     @db.VarChar(100)
  items     MenuItem[]

  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("menus")
}

model MenuItem {
  id           String     @id @default(uuid()) @db.Uuid
  menuId       String     @map("menu_id") @db.Uuid
  parentId     String?    @map("parent_id") @db.Uuid

  label        String     @db.VarChar(100)
  href         String     @db.VarChar(255)
  description  String?    @db.Text
  targetBlank  Boolean    @default(false) @map("target_blank")

  sortOrder    Int        @default(0) @map("sort_order")
  isActive     Boolean    @default(true) @map("is_active")

  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent       MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     MenuItem[] @relation("MenuHierarchy")

  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([menuId, sortOrder])
  @@map("menu_items")
}

model HeroSlide {
  id          String          @id @default(uuid()) @db.Uuid
  unitCode    String?         @map("unit_code") @db.VarChar(50)
  badge       String          @db.VarChar(100)
  title       String          @db.VarChar(255)
  subtitle    String          @db.Text
  imageUrl    String          @map("image_url") @db.VarChar(500)
  href        String          @db.VarChar(255)

  targetType  SlideTargetType @default(INTERNAL) @map("target_type")
  targetValue String?         @map("target_value") @db.VarChar(255)

  sortOrder   Int             @default(0) @map("sort_order")
  isActive    Boolean         @default(true) @map("is_active")

  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("hero_slides")
}

model SiteStatistic {
  id          String   @id @default(uuid()) @db.Uuid
  sectionCode String   @map("section_code") @db.VarChar(50)
  label       String   @db.VarChar(100)
  value       String   @db.VarChar(50)
  icon        String?  @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([sectionCode, sortOrder])
  @@map("site_statistics")
}

model SiteFeature {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(150)
  icon        String   @db.VarChar(50)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("site_features")
}

model FeaturedProgram {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(150)
  desc        String   @map("description") @db.Text
  icon        String   @db.VarChar(50)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("featured_programs")
}

// ==================================================
// 4. EDUCATION UNITS & CHILD MODELS
// ==================================================

model EducationUnit {
  id             String            @id @default(uuid()) @db.Uuid
  code           String            @unique @db.VarChar(50)
  slug           String            @unique @db.VarChar(100)
  name           String            @db.VarChar(200)
  shortName      String?           @map("short_name") @db.VarChar(100)
  badge          String?           @db.VarChar(100)
  tagline        String?           @db.VarChar(255)
  description    String?           @db.Text

  heroTitle      String?           @map("hero_title") @db.VarChar(255)
  heroSubtitle   String?           @map("hero_subtitle") @db.Text
  heroImage      String?           @map("hero_image") @db.VarChar(500)

  profileTitle   String?           @map("profile_title") @db.VarChar(255)
  profileBody    String[]          @default([]) @map("profile_body")

  curriculumTitle String?          @map("curriculum_title") @db.VarChar(255)
  curriculumBody String[]          @default([]) @map("curriculum_body")

  features       UnitFeature[]
  programs       UnitProgram[]
  facilities     UnitFacility[]
  activities     UnitActivity[]
  achievements   Achievement[]
  agendas        Agenda[]
  testimonials   Testimonial[]
  galleryAlbums  GalleryAlbum[]
  brochures      Brochure[]
  ppdbApplications PpdbApplication[]

  isActive       Boolean           @default(true) @map("is_active")
  sortOrder      Int               @default(0) @map("sort_order")

  seoTitle       String?           @map("seo_title") @db.VarChar(255)
  seoDescription String?           @map("seo_description") @db.VarChar(500)

  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?         @map("deleted_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("education_units")
}

model UnitFeature {
  id          String        @id @default(uuid()) @db.Uuid
  unitId      String        @map("unit_id") @db.Uuid
  title       String        @db.VarChar(150)
  description String?       @db.Text
  icon        String?       @db.VarChar(50)
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")

  unit        EducationUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([unitId, sortOrder])
  @@map("unit_features")
}

model UnitProgram {
  id          String        @id @default(uuid()) @db.Uuid
  unitId      String        @map("unit_id") @db.Uuid
  title       String        @db.VarChar(150)
  description String        @db.Text
  badge       String?       @db.VarChar(100)
  imageUrl    String?       @map("image_url") @db.VarChar(500)
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")

  unit        EducationUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([unitId, sortOrder])
  @@map("unit_programs")
}

model UnitFacility {
  id          String        @id @default(uuid()) @db.Uuid
  unitId      String        @map("unit_id") @db.Uuid
  name        String        @db.VarChar(150)
  description String        @db.Text
  imageUrl    String        @map("image_url") @db.VarChar(500)
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")

  unit        EducationUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([unitId, sortOrder])
  @@map("unit_facilities")
}

model UnitActivity {
  id          String        @id @default(uuid()) @db.Uuid
  unitId      String        @map("unit_id") @db.Uuid
  title       String        @db.VarChar(150)
  description String        @db.Text
  time        String?       @db.VarChar(100)
  imageUrl    String        @map("image_url") @db.VarChar(500)
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")

  unit        EducationUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([unitId, sortOrder])
  @@map("unit_activities")
}

// ==================================================
// 5. CONTENT MODULE (NEWS, OPINIONS, AGENDAS, ETC.)
// ==================================================

model NewsCategory {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(150)
  slug        String        @unique @db.VarChar(150)
  description String?       @db.Text

  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")

  articles    NewsArticle[]

  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("news_categories")
}

model Tag {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @db.VarChar(100)
  slug        String           @unique @db.VarChar(100)

  newsTags    NewsArticleTag[]

  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("tags")
}

model NewsArticle {
  id              String           @id @default(uuid()) @db.Uuid
  categoryId      String           @map("category_id") @db.Uuid
  slug            String           @unique @db.VarChar(255)
  title           String           @db.VarChar(300)
  excerpt         String           @db.Text
  content         String[]         @default([])
  featuredImage   String           @map("featured_image") @db.VarChar(500)
  author          String           @default("Redaksi Cendekia Amanah") @db.VarChar(150)
  authorAdminId   String?          @map("author_admin_id") @db.Uuid

  highlightQuote  String?          @map("highlight_quote") @db.Text
  viewsCount      BigInt           @default(0) @map("views_count")

  status          ContentStatus    @default(PUBLISHED)
  isFeatured      Boolean          @default(false) @map("is_featured")
  isPopular       Boolean          @default(false) @map("is_popular")

  publishedAt     DateTime?        @map("published_at") @db.Timestamptz(3)
  publishedDateText String?        @map("published_date_text") @db.VarChar(50)

  seoTitle        String?          @map("seo_title") @db.VarChar(255)
  seoDescription  String?          @map("seo_description") @db.VarChar(500)

  category        NewsCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  authorAdmin     AdminUser?       @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)
  articleTags     NewsArticleTag[]

  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz(3)

  @@index([status, publishedAt])
  @@index([categoryId, publishedAt])
  @@index([isFeatured, publishedAt])
  @@index([isPopular, publishedAt])
  @@map("news_articles")
}

model NewsArticleTag {
  newsArticleId String      @map("news_article_id") @db.Uuid
  tagId         String      @map("tag_id") @db.Uuid

  newsArticle   NewsArticle @relation(fields: [newsArticleId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([newsArticleId, tagId])
  @@map("news_article_tags")
}

model OpinionAuthor {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @db.VarChar(150)
  role      String           @db.VarChar(150)
  avatar    String           @db.VarChar(500)
  bio       String?          @db.Text
  isActive  Boolean          @default(true) @map("is_active")

  articles  OpinionArticle[]

  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("opinion_authors")
}

model OpinionArticle {
  id              String        @id @default(uuid()) @db.Uuid
  authorId        String        @map("author_id") @db.Uuid
  slug            String        @unique @db.VarChar(255)
  title           String        @db.VarChar(300)
  excerpt         String        @db.Text
  content         String[]      @default([])
  readTime        String        @default("5 menit baca") @map("read_time") @db.VarChar(50)
  highlightQuote  String?       @map("highlight_quote") @db.Text
  tags            String[]      @default([])

  status          ContentStatus @default(PUBLISHED)
  isFeatured      Boolean       @default(false) @map("is_featured")

  publishedAt     DateTime?     @map("published_at") @db.Timestamptz(3)
  publishedDateText String?     @map("published_date_text") @db.VarChar(50)

  seoTitle        String?       @map("seo_title") @db.VarChar(255)
  seoDescription  String?       @map("seo_description") @db.VarChar(500)

  author          OpinionAuthor @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(3)

  @@index([status, publishedAt])
  @@index([authorId, publishedAt])
  @@map("opinion_articles")
}

model Agenda {
  id          String         @id @default(uuid()) @db.Uuid
  unitId      String?        @map("unit_id") @db.Uuid
  title       String         @db.VarChar(255)
  description String?        @db.Text
  day         String         @db.VarChar(10)
  month       String         @db.VarChar(20)
  year        String         @default("2026") @db.VarChar(10)
  time        String         @db.VarChar(100)
  location    String?        @db.VarChar(255)
  status      String?        @db.VarChar(50)
  isFeatured  Boolean        @default(false) @map("is_featured")
  isActive    Boolean        @default(true) @map("is_active")

  unit        EducationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)

  @@map("agendas")
}

model Achievement {
  id          String         @id @default(uuid()) @db.Uuid
  unitId      String?        @map("unit_id") @db.Uuid
  title       String         @db.VarChar(255)
  winner      String         @db.VarChar(200)
  category    String         @db.VarChar(100)
  year        String         @db.VarChar(10)
  badge       String         @db.VarChar(100)
  imageUrl    String?        @map("image_url") @db.VarChar(500)
  isFeatured  Boolean        @default(true) @map("is_featured")
  isActive    Boolean        @default(true) @map("is_active")
  sortOrder   Int            @default(0) @map("sort_order")

  unit        EducationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)

  @@map("achievements")
}

model GalleryAlbum {
  id          String        @id @default(uuid()) @db.Uuid
  unitId      String?       @map("unit_id") @db.Uuid
  title       String        @db.VarChar(200)
  slug        String        @unique @db.VarChar(200)
  description String?       @db.Text
  coverImage  String?       @map("cover_image") @db.VarChar(500)
  isActive    Boolean       @default(true) @map("is_active")

  unit        EducationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  items       GalleryItem[]

  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("gallery_albums")
}

model GalleryItem {
  id          String        @id @default(uuid()) @db.Uuid
  albumId     String?       @map("album_id") @db.Uuid
  mediaId     String?       @map("media_id") @db.Uuid
  title       String        @db.VarChar(200)
  category    String        @db.VarChar(100)
  imageUrl    String        @map("image_url") @db.VarChar(500)
  caption     String?       @db.Text
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")

  album       GalleryAlbum? @relation(fields: [albumId], references: [id], onDelete: SetNull)
  media       MediaAsset?   @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("gallery_items")
}

model Testimonial {
  id          String         @id @default(uuid()) @db.Uuid
  unitId      String?        @map("unit_id") @db.Uuid
  author      String         @db.VarChar(150)
  role        String         @db.VarChar(150)
  category    String         @db.VarChar(100)
  content     String         @db.Text
  avatar      String         @db.VarChar(500)
  sortOrder   Int            @default(0) @map("sort_order")
  isActive    Boolean        @default(true) @map("is_active")

  unit        EducationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("testimonials")
}

model Partner {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(150)
  logo       String   @db.VarChar(500)
  websiteUrl String?  @map("website_url") @db.VarChar(500)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("partners")
}

model Brochure {
  id           String         @id @default(uuid()) @db.Uuid
  unitId       String?        @map("unit_id") @db.Uuid
  unitName     String         @map("unit_name") @db.VarChar(150)
  title        String         @db.VarChar(255)
  fileSize     String         @map("file_size") @db.VarChar(50)
  fileUrl      String         @map("file_url") @db.VarChar(500)
  academicYear String?        @map("academic_year") @db.VarChar(50)
  status       BrochureStatus @default(AVAILABLE)
  sortOrder    Int            @default(0) @map("sort_order")

  unit         EducationUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("brochures")
}

model Faq {
  id        String   @id @default(uuid()) @db.Uuid
  category  String?  @db.VarChar(100)
  question  String   @db.Text
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("faqs")
}

// ==================================================
// 6. PUBLIC ENGAGEMENT (PPDB, CONTACT, NEWSLETTER)
// ==================================================

model PpdbApplication {
  id               String                @id @default(uuid()) @db.Uuid
  registrationNo   String                @unique @map("registration_no") @db.VarChar(30)
  academicYear     String                @default("2027/2028") @map("academic_year") @db.VarChar(20)

  fullName         String                @map("full_name") @db.VarChar(200)
  nisn             String                @db.VarChar(10)
  birthPlaceDate   String                @map("birth_place_date") @db.VarChar(150)
  previousSchool   String                @map("previous_school") @db.VarChar(255)

  parentName       String                @map("parent_name") @db.VarChar(200)
  whatsapp         String                @db.VarChar(30)
  address          String                @db.Text

  unitCode         String                @map("unit_code") @db.VarChar(50)
  unitId           String?               @map("unit_id") @db.Uuid
  attendanceMode   AttendanceMode?       @map("attendance_mode")
  notes            String?               @db.Text

  status           PpdbStatus            @default(SUBMITTED)
  sourceIp         String?               @map("source_ip") @db.VarChar(64)
  userAgent        String?               @map("user_agent") @db.Text
  submittedAt      DateTime              @default(now()) @map("submitted_at") @db.Timestamptz(3)

  unit             EducationUnit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)
  statusHistories  PpdbStatusHistory[]

  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?             @map("deleted_at") @db.Timestamptz(3)

  @@unique([academicYear, nisn])
  @@index([status, createdAt])
  @@index([unitId, createdAt])
  @@index([academicYear, status])
  @@map("ppdb_applications")
}

model PpdbStatusHistory {
  id            String          @id @default(uuid()) @db.Uuid
  applicationId String          @map("application_id") @db.Uuid
  fromStatus    PpdbStatus?     @map("from_status")
  toStatus      PpdbStatus      @map("to_status")
  note          String?         @db.Text
  changedById   String?         @map("changed_by") @db.Uuid

  application   PpdbApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([applicationId, createdAt])
  @@map("ppdb_status_histories")
}

model ContactMessage {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @db.VarChar(150)
  email     String        @db.VarChar(255)
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  sourceIp  String?       @map("source_ip") @db.VarChar(64)
  userAgent String?       @map("user_agent") @db.Text

  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("contact_messages")
}

model NewsletterSubscription {
  id                     String           @id @default(uuid()) @db.Uuid
  email                  String           @unique @db.VarChar(255)
  status                 NewsletterStatus @default(ACTIVE)
  verificationTokenHash  String?          @map("verification_token_hash") @db.VarChar(255)
  unsubscribeTokenHash   String?          @map("unsubscribe_token_hash") @db.VarChar(255)
  verifiedAt             DateTime?        @map("verified_at") @db.Timestamptz(3)
  unsubscribedAt         DateTime?        @map("unsubscribed_at") @db.Timestamptz(3)

  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("newsletter_subscriptions")
}
